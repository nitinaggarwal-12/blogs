      <mxCell id="req_a" value="&lt;div style='font-family:Comic Sans MS,Arial,sans-serif;color:#1E3A8A;'&gt;&lt;div style='font-size:15px;font-weight:700;line-height:1.18;'&gt;&lt;i&gt;&lt;b&gt;Caller 1&lt;/b&gt;&lt;/i&gt; &lt;/div&gt;&lt;div style='font-size:15px;font-weight:700;line-height:1.18;'&gt;Tenant A Request&lt;/div&gt;&lt;div style='height:3px;'&gt;&lt;/div&gt;&lt;div style='font-size:12px;font-weight:400;line-height:1.22;color:#1D4ED8;'&gt;• sub: user-a@tenant-a.example&lt;/div&gt;&lt;div style='font-size:12px;font-weight:400;line-height:1.22;color:#1D4ED8;'&gt;• tenant_id: tenant-a&lt;/div&gt;&lt;div style='font-size:12px;font-weight:400;line-height:1.22;color:#1D4ED8;'&gt;• OBO + DPoP JWT&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fillColor=#E8F0FE;strokeColor=#93C5FD;strokeWidth=1.5;fontColor=#1E3A8A;verticalAlign=middle;align=center;shadow=1;" vertex="1" parent="1">
