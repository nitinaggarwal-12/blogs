      <mxCell id="ctx_bind" value="&lt;div style='font-family:Comic Sans MS,Arial,sans-serif;color:#0F172A;'&gt;&lt;div style='font-size:15px;font-weight:700;line-height:1.18;'&gt;&lt;i&gt;&lt;b&gt;Guardrail 1&lt;/b&gt;&lt;/i&gt; &lt;/div&gt;&lt;div style='font-size:15px;font-weight:700;line-height:1.18;'&gt;Cryptographic&lt;/div&gt;&lt;div style='font-size:15px;font-weight:700;line-height:1.18;'&gt;Context Binder&lt;/div&gt;&lt;div style='height:3px;'&gt;&lt;/div&gt;&lt;div style='font-size:12px;font-weight:400;line-height:1.22;color:#475569;'&gt;• Verifies SPIFFE SVID&lt;/div&gt;&lt;div style='font-size:12px;font-weight:400;line-height:1.22;color:#475569;'&gt;• Locks immutable (tenant_id, sub)&lt;/div&gt;&lt;div style='font-size:12px;font-weight:400;line-height:1.22;color:#475569;'&gt;• Blocks header spoofing&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;verticalAlign=middle;align=center;shadow=1;" vertex="1" parent="1">
