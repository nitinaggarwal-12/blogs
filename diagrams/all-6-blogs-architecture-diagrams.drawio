      <mxCell id="req_b" value="&lt;div style='font-family:Comic Sans MS,Arial,sans-serif;color:#78350F;'&gt;&lt;div style='font-size:15px;font-weight:700;line-height:1.18;'&gt;&lt;i&gt;&lt;b&gt;Caller 2&lt;/b&gt;&lt;/i&gt; &lt;/div&gt;&lt;div style='font-size:15px;font-weight:700;line-height:1.18;'&gt;Tenant B Request&lt;/div&gt;&lt;div style='height:3px;'&gt;&lt;/div&gt;&lt;div style='font-size:12px;font-weight:400;line-height:1.22;color:#B45309;'&gt;• sub: user-b@tenant-b.example&lt;/div&gt;&lt;div style='font-size:12px;font-weight:400;line-height:1.22;color:#B45309;'&gt;• tenant_id: tenant-b&lt;/div&gt;&lt;div style='font-size:12px;font-weight:400;line-height:1.22;color:#B45309;'&gt;• OBO + DPoP JWT&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fillColor=#FEF7E0;strokeColor=#FCD34D;strokeWidth=1.5;fontColor=#78350F;verticalAlign=middle;align=center;shadow=1;" vertex="1" parent="1">
