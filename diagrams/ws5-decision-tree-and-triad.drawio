        <mxCell id="tier_c" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:12.5px;font-weight:700;line-height:1.28;color:#1E3A8A;text-align:left;&quot;&gt;Standard Commercial SaaS&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:400;line-height:1.28;color:#1D4ED8;text-align:left;margin-top:6px;&quot;&gt;• SOC 2 Type II / ISO 27001&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:400;line-height:1.28;color:#1D4ED8;text-align:left;margin-top:3px;&quot;&gt;• High-velocity PLG onboarding&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#93C5FD;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="52" y="122" width="268" height="112" as="geometry"/></mxCell>
        <mxCell id="gate_pool" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:12.5px;font-weight:700;line-height:1.28;color:#202124;text-align:left;&quot;&gt;Gate 1 · Shared Pool Baseline&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:400;line-height:1.28;color:#5F6368;text-align:left;margin-top:6px;&quot;&gt;• q_spoke = 0, q_silo = 0 (no silo mandate)&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:400;line-height:1.28;color:#5F6368;text-align:left;margin-top:3px;&quot;&gt;• AlloyDB FORCE RLS + Valkey 120 RPM&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="400" y="122" width="360" height="112" as="geometry"/></mxCell>
        <mxCell id="pat_a" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:700;line-height:1.28;color:#065F46;text-align:left;&quot;&gt;Pattern A: Pool (WS2)&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:400;line-height:1.28;color:#047857;text-align:left;margin-top:6px;&quot;&gt;• Shared Cloud Run / WarmPool, Gateways &amp;amp; RLS&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:400;line-height:1.28;color:#047857;text-align:left;margin-top:3px;&quot;&gt;• 1,000+ tenants at 1.0x baseline COGS&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#34D399;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="850" y="122" width="356" height="112" as="geometry"/></mxCell>
        <mxCell id="out_a" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:13.5px;font-weight:700;line-height:1.28;color:#065F46;text-align:center;&quot;&gt;1,000+ Tenants&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:700;line-height:1.28;color:#047857;text-align:center;margin-top:4px;&quot;&gt;1.0x Baseline COGS&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.8px;font-weight:400;line-height:1.28;color:#334155;text-align:center;margin-top:4px;&quot;&gt;~85% Prefix Cache&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34D399;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1280" y="128" width="268" height="100" as="geometry"/></mxCell>
        <mxCell id="tier_a" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:12.5px;font-weight:700;line-height:1.28;color:#78350F;text-align:left;&quot;&gt;Enterprise Hybrid Tenants&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:400;line-height:1.28;color:#B45309;text-align:left;margin-top:6px;&quot;&gt;• Private spoke DB / MCP tools&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:400;line-height:1.28;color:#B45309;text-align:left;margin-top:3px;&quot;&gt;• Unidirectional /28 PSC spokes&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#FCD34D;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="52" y="264" width="268" height="112" as="geometry"/></mxCell>
        <mxCell id="gate_hyb" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:12.5px;font-weight:700;line-height:1.28;color:#202124;text-align:left;&quot;&gt;Gate 2 · Shared Hub + Private Spoke?&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:400;line-height:1.28;color:#5F6368;text-align:left;margin-top:6px;&quot;&gt;• q_spoke = 1, q_silo = 0 (CMEK spoke VPC)&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:400;line-height:1.28;color:#5F6368;text-align:left;margin-top:3px;&quot;&gt;• 0ms atomic CAS promotion from Pattern A&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="400" y="264" width="360" height="112" as="geometry"/></mxCell>
        <mxCell id="pat_c" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:700;line-height:1.28;color:#1E3A8A;text-align:left;&quot;&gt;Pattern C: Governed Hub &amp;amp; Spoke (WS4)&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:400;line-height:1.28;color:#1D4ED8;text-align:left;margin-top:6px;&quot;&gt;• Shared Hub + Isolated /28 PSC Spokes&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:400;line-height:1.28;color:#1D4ED8;text-align:left;margin-top:3px;&quot;&gt;• 1.8x–2.8x COGS • 0 dropped turns on upgrade&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="850" y="264" width="356" height="112" as="geometry"/></mxCell>
        <mxCell id="out_c" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:13.5px;font-weight:700;line-height:1.28;color:#1E3A8A;text-align:center;&quot;&gt;1.8x–2.8x COGS&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:700;line-height:1.28;color:#1D4ED8;text-align:center;margin-top:4px;&quot;&gt;0ms Live Cutover&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.8px;font-weight:400;line-height:1.28;color:#334155;text-align:center;margin-top:4px;&quot;&gt;Unidirectional /28 PSC Spokes&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1280" y="270" width="268" height="100" as="geometry"/></mxCell>
        <mxCell id="tier_b" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:12.5px;font-weight:700;line-height:1.28;color:#4C1D95;text-align:left;&quot;&gt;Regulated Sovereign Tenants&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:400;line-height:1.28;color:#6D28D9;text-align:left;margin-top:6px;&quot;&gt;• OCC/FDIC, EU DORA, HIPAA GxP&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:400;line-height:1.28;color:#6D28D9;text-align:left;margin-top:3px;&quot;&gt;• Dedicated project &amp;amp; HSM CMEK&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#C4B5FD;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="52" y="406" width="268" height="112" as="geometry"/></mxCell>
        <mxCell id="gate_silo" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:12.5px;font-weight:700;line-height:1.28;color:#202124;text-align:left;&quot;&gt;Gate 3 · Dedicated GCP Project Silo?&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:400;line-height:1.28;color:#5F6368;text-align:left;margin-top:6px;&quot;&gt;• q_silo = 1 (physical project &amp;amp; VPC-SC)&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:400;line-height:1.28;color:#5F6368;text-align:left;margin-top:3px;&quot;&gt;• Customer HSM CMEK (&amp;lt;60s kill-switch)&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="400" y="406" width="360" height="112" as="geometry"/></mxCell>
        <mxCell id="pat_b" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:700;line-height:1.28;color:#5B21B6;text-align:left;&quot;&gt;Pattern B: Sovereign Silo (WS3)&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:400;line-height:1.28;color:#6D28D9;text-align:left;margin-top:6px;&quot;&gt;• Dedicated GCP Project, VPC-SC &amp;amp; IAM PAB&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:400;line-height:1.28;color:#6D28D9;text-align:left;margin-top:3px;&quot;&gt;• ~15x COGS • 0 cross-tenant blast radius&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="850" y="406" width="356" height="112" as="geometry"/></mxCell>
        <mxCell id="out_b" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:13.5px;font-weight:700;line-height:1.28;color:#5B21B6;text-align:center;&quot;&gt;~15x COGS · Full Silo&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:700;line-height:1.28;color:#6D28D9;text-align:center;margin-top:4px;&quot;&gt;41.2s CMEK Halt&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.8px;font-weight:400;line-height:1.28;color:#334155;text-align:center;margin-top:4px;&quot;&gt;Confidential GKE SEV-SNP&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A855F7;strokeWidth=1.5;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1280" y="412" width="268" height="100" as="geometry"/></mxCell>
        <mxCell id="triad_1" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:12.2px;font-weight:700;line-height:1.28;color:#174EA6;text-align:left;&quot;&gt;Invariant 1 · Dual Agent Gateways &amp;amp; Identity&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.2px;font-weight:400;line-height:1.28;color:#3C4043;text-align:left;margin-top:8px;&quot;&gt;• Inbound Client-to-Agent Gateway (OIDC/DPoP + Model Armor)&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.2px;font-weight:400;line-height:1.28;color:#3C4043;text-align:left;margin-top:5px;&quot;&gt;• Outbound Agent-to-Target Gateway (2LO/3LO OBO + Output DLP)&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.2px;font-weight:400;line-height:1.28;color:#3C4043;text-align:left;margin-top:5px;&quot;&gt;• Non-spoofable KMS P-256 STS JWT (&amp;lt;0.15ms JWKS verify)&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=50;spacingRight=12;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="54" y="584" width="464" height="168" as="geometry"/></mxCell>
