        <mxCell id="triad_2" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:12.2px;font-weight:700;line-height:1.28;color:#137333;text-align:left;&quot;&gt;Invariant 2 · 80% Reusable ADK Core Package&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.2px;font-weight:400;line-height:1.28;color:#3C4043;text-align:left;margin-top:8px;&quot;&gt;• Identical core-cymbal-agent/ Python code across Patterns A, B &amp;amp; C&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.2px;font-weight:400;line-height:1.28;color:#3C4043;text-align:left;margin-top:5px;&quot;&gt;• Only 20% Terraform perimeter variables change per tenant tier&lt;/div&gt;&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.2px;font-weight:400;line-height:1.28;color:#3C4043;text-align:left;margin-top:5px;&quot;&gt;• Eliminates multi-branch security, guardrail &amp;amp; prompt drift&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=50;spacingRight=12;spacingTop=6;spacingBottom=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="568" y="584" width="464" height="168" as="geometry"/></mxCell>
