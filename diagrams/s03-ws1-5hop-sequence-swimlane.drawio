        <mxCell id="brand_lbl" value="&lt;b&gt;Google Cloud&lt;/b&gt; &lt;span style=&quot;color:#5F6368;font-weight:400;&quot;&gt;Architecture Center&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#3C4043;" vertex="1" parent="1"><mxGeometry x="108" y="18" width="290" height="38" as="geometry"/></mxCell>
        <mxCell id="ws_pill" value="&lt;b&gt;WS1 + MC2&lt;/b&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.2;fontSize=12;fontColor=#1E293B;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="415" y="21" width="108" height="32" as="geometry"/></mxCell>
        <mxCell id="hdr_title" value="&lt;b&gt;WS1 + MC2 Protocol Anatomy: 5-Hop Wire Packets &amp; Keyless Cross-Cloud WIF&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="542" y="17" width="760" height="40" as="geometry"/></mxCell>
        <mxCell id="r_pill" value="&lt;b&gt;BARE-MIN 03/12 • PROTOCOL ANATOMY&lt;/b&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.2;fontSize=11;fontColor=#475569;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1315" y="21" width="245" height="32" as="geometry"/></mxCell>
        <mxCell id="sub_lbl" value="Bare-Min 03/12 • C4 L3 Temporal Swimlane: OIDC JWT1 -&gt; RFC 9449 DPoP Binding -&gt; RFC 8693 OBO -&gt; Downscoped 3LO -&gt; Keyless AWS STS WIF" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="44" y="76" width="1512" height="28" as="geometry"/></mxCell>
        <mxCell id="h1_head" value="&lt;b&gt;Hop 1: Workforce IdP&lt;br&gt;(Cloud Identity / Entra)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#1D4ED8;&quot;&gt;Issues short-lived JWT1&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=13.5;fontColor=#1E3A8A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="44" y="132" width="260" height="104" as="geometry"/></mxCell>
        <mxCell id="h1_pkt" value="&lt;i style=&quot;font-size:12px;color:#334155;&quot;&gt;Wire Packet 1&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px;color:#0F172A;&quot;&gt;OIDC ID Token (JWT1)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#0F172A;&quot;&gt;• sub: user-a@tenant-a.example&lt;br&gt;• tenant_id: tenant-a-prod&lt;br&gt;• aud: ingress-gateway&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="44" y="316" width="260" height="182" as="geometry"/></mxCell>
        <mxCell id="h1_guard" value="&lt;b style=&quot;font-size:13.5px;color:#991B1B;&quot;&gt;Zero Directory Sync&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#334155;&quot;&gt;• Verified OIDC claims&lt;br&gt;• 0 static API keys&lt;br&gt;• ALB strips X-Tenant-Id&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FCA5A5;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="44" y="582" width="260" height="174" as="geometry"/></mxCell>
        <mxCell id="h1_e1" value="Mint JWT1" style="endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;fontColor=#334155;" edge="1" source="h1_head" target="h1_pkt" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h1_e2" value="" style="endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.6;" edge="1" source="h1_pkt" target="h1_guard" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h1_h" value="Hop 1&#8594;2" style="endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.8;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry y="14" relative="1" as="geometry"><mxPoint x="304" y="407" as="sourcePoint"/><mxPoint x="358" y="407" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="h2_head" value="&lt;b&gt;Hop 2: Ingress GW &amp;&lt;br&gt;STS Token Broker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#1D4ED8;&quot;&gt;RFC 8693 + RFC 9449 DPoP&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=1.5;fontSize=13.5;fontColor=#1D4ED8;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="358" y="132" width="260" height="104" as="geometry"/></mxCell>
        <mxCell id="h2_pkt" value="&lt;i style=&quot;font-size:12px;color:#334155;&quot;&gt;Wire Packet 2&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px;color:#065F46;&quot;&gt;DPoP-Bound STS Token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#065F46;&quot;&gt;• cnf.jkt thumbprint bound&lt;br&gt;• Raw user token stripped&lt;br&gt;• In-memory JWKS &lt;0.15ms&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#6EE7B7;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="358" y="316" width="260" height="182" as="geometry"/></mxCell>
        <mxCell id="h2_guard" value="&lt;b style=&quot;font-size:13.5px;color:#0F172A;&quot;&gt;Prompt-Injection Safe&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#334155;&quot;&gt;• LLM never sees raw secret&lt;br&gt;• DPoP proof-of-possession&lt;br&gt;• Valkey JTI &lt;0.4ms check&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="358" y="582" width="260" height="174" as="geometry"/></mxCell>
        <mxCell id="h2_e1" value="Bind DPoP" style="endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;fontColor=#334155;" edge="1" source="h2_head" target="h2_pkt" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h2_e2" value="" style="endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.6;" edge="1" source="h2_pkt" target="h2_guard" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h2_h" value="Hop 2&#8594;3" style="endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.8;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry y="14" relative="1" as="geometry"><mxPoint x="618" y="407" as="sourcePoint"/><mxPoint x="672" y="407" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="h3_head" value="&lt;b&gt;Hop 3: ADK Runtime -&gt;&lt;br&gt;Specialist Agent A2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#1D4ED8;&quot;&gt;A2A over SPIFFE mTLS&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#34D399;strokeWidth=1.5;fontSize=13.5;fontColor=#065F46;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="672" y="132" width="260" height="104" as="geometry"/></mxCell>
        <mxCell id="h3_pkt" value="&lt;i style=&quot;font-size:12px;color:#334155;&quot;&gt;Wire Packet 3&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px;color:#78350F;&quot;&gt;Delegated JWT3 (OBO)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#78350F;&quot;&gt;• sub: user-a@tenant-a.example&lt;br&gt;• act: urn:agent:planner-a1&lt;br&gt;• CoW 1-turn gVisor wipe&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#FCD34D;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="672" y="316" width="260" height="182" as="geometry"/></mxCell>
        <mxCell id="h3_guard" value="&lt;b style=&quot;font-size:13.5px;color:#0F172A;&quot;&gt;Mutual Attestation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#334155;&quot;&gt;• SPIFFE x509-SVID mTLS&lt;br&gt;• 120/600 RPM bulkhead&lt;br&gt;• 32k prefix cache (0.10x)&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="672" y="582" width="260" height="174" as="geometry"/></mxCell>
        <mxCell id="h3_e1" value="RFC 8693" style="endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;fontColor=#334155;" edge="1" source="h3_head" target="h3_pkt" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h3_e2" value="" style="endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.6;" edge="1" source="h3_pkt" target="h3_guard" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h3_h" value="Hop 3&#8594;4" style="endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.8;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry y="14" relative="1" as="geometry"><mxPoint x="932" y="407" as="sourcePoint"/><mxPoint x="986" y="407" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="h4_head" value="&lt;b&gt;Hop 4: Outbound GW -&gt;&lt;br&gt;SaaS MCP (ThoughtSpot/Jira)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#1D4ED8;&quot;&gt;Downscoped 3LO + IAM CAB&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=13.5;fontColor=#1E40AF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="986" y="132" width="260" height="104" as="geometry"/></mxCell>
        <mxCell id="h4_pkt" value="&lt;i style=&quot;font-size:12px;color:#334155;&quot;&gt;Wire Packet 4&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px;color:#4C1D95;&quot;&gt;Scoped 3LO Access Token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#4C1D95;&quot;&gt;• typ: at+jwt (RFC 9068)&lt;br&gt;• Model Armor &lt;8ms screen&lt;br&gt;• 0 interactive popups&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#C4B5FD;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="986" y="316" width="260" height="182" as="geometry"/></mxCell>
        <mxCell id="h4_guard" value="&lt;b style=&quot;font-size:13.5px;color:#0F172A;&quot;&gt;Model Armor + DLP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#334155;&quot;&gt;• Redacts PII in tool output&lt;br&gt;• Semantic egress NLC&lt;br&gt;• ARD catalog PDP (-94%)&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="986" y="582" width="260" height="174" as="geometry"/></mxCell>
        <mxCell id="h4_e1" value="3LO CAB" style="endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;fontColor=#334155;" edge="1" source="h4_head" target="h4_pkt" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h4_e2" value="" style="endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.6;" edge="1" source="h4_pkt" target="h4_guard" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h4_h" value="Hop 4&#8594;5" style="endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.8;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry y="14" relative="1" as="geometry"><mxPoint x="1246" y="407" as="sourcePoint"/><mxPoint x="1300" y="407" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="h5_head" value="&lt;b&gt;Hop 5: Cross-Cloud&lt;br&gt;AWS STS AgentCore WIF&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#1D4ED8;&quot;&gt;Keyless Workload Identity&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontSize=13.5;fontColor=#065F46;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1300" y="132" width="260" height="104" as="geometry"/></mxCell>
        <mxCell id="h5_pkt" value="&lt;i style=&quot;font-size:12px;color:#334155;&quot;&gt;Wire Packet 5&lt;/i&gt;&lt;br&gt;&lt;b style=&quot;font-size:14px;color:#78350F;&quot;&gt;Cloud Run MDS -&gt; AWS STS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#78350F;&quot;&gt;• GCP OIDC assertion -&gt; WIF&lt;br&gt;• STS AssumeRoleWithWebId&lt;br&gt;• Databricks / Unity Catalog OBO&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1300" y="316" width="260" height="182" as="geometry"/></mxCell>
        <mxCell id="h5_guard" value="&lt;b style=&quot;font-size:13.5px;color:#1E3A8A;&quot;&gt;Zero Stored Secrets&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#334155;&quot;&gt;• 0 keys in Secret Manager&lt;br&gt;• 15-min ephemeral token&lt;br&gt;• AlloyDB FORCE RLS&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#60A5FA;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1300" y="582" width="260" height="174" as="geometry"/></mxCell>
        <mxCell id="h5_e1" value="WIF STS" style="endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.6;fontSize=11;fontColor=#334155;" edge="1" source="h5_head" target="h5_pkt" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="h5_e2" value="" style="endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.6;" edge="1" source="h5_pkt" target="h5_guard" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pk_ctrl" value="&lt;b style=&quot;color:#1D4ED8;&quot;&gt;CONTROL&lt;/b&gt; &lt;span style=&quot;color:#334155;&quot;&gt;OIDC JWT1 + DPoP/OBO STS + ARD PDP + Model Armor (&lt;8ms) + WIF STS&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#93C5FD;strokeWidth=1.1;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="44" y="818" width="492" height="32" as="geometry"/></mxCell>
        <mxCell id="pk_comp" value="&lt;b style=&quot;color:#047857;&quot;&gt;COMPUTE&lt;/b&gt; &lt;span style=&quot;color:#334155;&quot;&gt;Cloud Run gVisor CoW + 32k shared prefix cache (0.10x, 89.1% net)&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#86EFAC;strokeWidth=1.1;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="554" y="818" width="492" height="32" as="geometry"/></mxCell>
        <mxCell id="pk_data" value="&lt;b style=&quot;color:#C2410C;&quot;&gt;DATA&lt;/b&gt; &lt;span style=&quot;color:#334155;&quot;&gt;Valkey 0.4ms JTI deny-list + AlloyDB FORCE RLS + 3LO Databricks/Unity&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FDBA74;strokeWidth=1.1;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1064" y="818" width="492" height="32" as="geometry"/></mxCell>
        <mxCell id="ftr_lbl" value="[Bare-Min 03/12 • WS1 + MC2 Protocol Anatomy] • ▸ 2-Way Draw.io ↗" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="44" y="858" width="900" height="24" as="geometry"/></mxCell>
