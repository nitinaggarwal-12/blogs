<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="embed.diagrams.net" modified="2026-10-31T05:00:00.000Z" agent="PromptCanvas-Vision-Decompiler-v4.0" version="24.7.5" type="device">
  <diagram id="ws1-l4-wire-protocol-transformation" name="C4 L4: Wire-Level Protocol Normalization">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Header -->
        <mxCell id="hdr_title" value="&lt;div style=&quot;font-family:'Google Sans',Roboto,Arial,sans-serif;&quot;&gt;&lt;b style=&quot;font-size:14px;color:#174ea6;&quot;&gt;[WORKSTREAM 1 • C4 LEVEL 4] Wire-Level Protocol Normalization: Hop 1 Spoofed Header Stripping &amp;amp; Signed STS JWT Context&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;color:#5f6368;&quot;&gt;Cryptographic Transformation Triptych: Untrusted Ingress Request ➔ Hop 1 Security Gate ➔ Sender-Constrained STS JWT&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="1140" height="40" as="geometry"/>
        </mxCell>

        <!-- STAGE 01: Untrusted Ingress -->
        <mxCell id="card_untrusted_req" value="&lt;b style=&quot;font-size:13px;color:#dc2626;&quot;&gt;Untrusted Caller Ingress Request&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;color:#64748b;&quot;&gt;HTTP Payload with Forged Tenant Claim&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;div style=&quot;font-family:monospace;font-size:11px;text-align:left;background:#f8fafc;padding:10px;border-radius:6px;border:1px solid #e2e8f0;color:#0f172a;&quot;&gt;{&lt;br/&gt;&amp;nbsp;&amp;nbsp;&quot;Authorization&quot;: &quot;Bearer &amp;lt;jwt&amp;gt;&quot;,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&quot;client_headers&quot;: [&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#dc2626;background:#fee2e2;padding:1px 4px;border-radius:3px;&quot;&gt;&quot;X-Tenant-Id: finvault&quot;&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;],&lt;br/&gt;&amp;nbsp;&amp;nbsp;&quot;override_attempt&quot;: [&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#dc2626;background:#fee2e2;padding:1px 4px;border-radius:3px;&quot;&gt;&amp;lt;spoofed tenant header&amp;gt;&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;]&lt;br/&gt;}&lt;/div&gt;&lt;br/&gt;&lt;b style=&quot;font-size:11px;color:#dc2626;&quot;&gt;&#10005; Unverified Client Claims • Blocked at Edge&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef4444;strokeWidth=2;align=center;verticalAlign=top;spacingTop=16;spacingLeft=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="340" height="540" as="geometry"/>
        </mxCell>

        <!-- STAGE 02: Hop 1 Security Gate -->
        <mxCell id="card_security_gate" value="&lt;b style=&quot;font-size:14px;color:#38bdf8;&quot;&gt;Hop 1 IAM STS &amp;amp;&lt;br/&gt;DPoP Security Gate&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;color:#94a3b8;&quot;&gt;RFC 8693 &amp;amp; RFC 9449 Cryptographic Bridge&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;div style=&quot;background:#1e293b;padding:12px;border-radius:6px;border:1px solid #334155;color:#e2e8f0;margin-bottom:12px;text-align:center;&quot;&gt;&lt;b style=&quot;color:#38bdf8;font-size:11.5px;&quot;&gt;STAGE 01&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Cloud Armor Header Strip&lt;br/&gt;&lt;i style=&quot;font-size:9.5px;color:#94a3b8;&quot;&gt;Removes untrusted X-Tenant-Id&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;background:#1e293b;padding:12px;border-radius:6px;border:1px solid #334155;color:#e2e8f0;margin-bottom:12px;text-align:center;&quot;&gt;&lt;b style=&quot;color:#38bdf8;font-size:11.5px;&quot;&gt;STAGE 02&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;RFC 8693 OBO + DPoP JKT&lt;br/&gt;&lt;i style=&quot;font-size:9.5px;color:#94a3b8;&quot;&gt;Asymmetric proof-of-possession binding&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;background:#1e293b;padding:12px;border-radius:6px;border:1px solid #334155;color:#e2e8f0;text-align:center;&quot;&gt;&lt;b style=&quot;color:#38bdf8;font-size:11.5px;&quot;&gt;STAGE 03&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Cloud KMS ECDSA P-256 Sign&lt;br/&gt;&lt;i style=&quot;font-size:9.5px;color:#94a3b8;&quot;&gt;Mints 5-Min STS JWT Context&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#38bdf8;strokeWidth=2;align=center;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="430" y="80" width="340" height="540" as="geometry"/>
        </mxCell>

        <!-- STAGE 03: Signed STS JWT Context -->
        <mxCell id="card_signed_jwt" value="&lt;b style=&quot;font-size:13px;color:#16a34a;&quot;&gt;Signed STS JWT TenantContext&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;color:#64748b;&quot;&gt;Sender-Constrained Cryptographic Identity&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;div style=&quot;font-family:monospace;font-size:11px;text-align:left;background:#f8fafc;padding:10px;border-radius:6px;border:1px solid #e2e8f0;color:#0f172a;&quot;&gt;{&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#16a34a;background:#dcfce7;padding:1px 4px;border-radius:3px;&quot;&gt;&quot;tenant_id&quot;: &quot;retailstream&quot;&lt;/span&gt;,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#16a34a;&quot;&gt;&quot;tier&quot;: &quot;STANDARD&quot;&lt;/span&gt;,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#16a34a;background:#dcfce7;padding:1px 4px;border-radius:3px;&quot;&gt;&quot;dpop_jkt&quot;: &quot;sha256:9f86d081...&quot;&lt;/span&gt;,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&quot;memory_ns&quot;: &quot;tenants/retail&quot;,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&quot;rls_tag&quot;: &quot;current_tenant_id&quot;,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#16a34a;&quot;&gt;&quot;jwt_sig&quot;: &quot;kms_ecdsa_p256&quot;&lt;/span&gt;&lt;br/&gt;}&lt;/div&gt;&lt;br/&gt;&lt;b style=&quot;font-size:11px;color:#16a34a;&quot;&gt;&#10004; &amp;lt;0.15ms Cached-JWKS Verify • 0 KMS Network RPCs&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22c55e;strokeWidth=2;align=center;verticalAlign=top;spacingTop=16;spacingLeft=14;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry x="820" y="80" width="340" height="540" as="geometry"/>
        </mxCell>

        <!-- Connecting Transformation Arrows -->
        <mxCell id="e_stage1_to_stage2" value="Strip + OBO" style="edgeStyle=none;rounded=0;html=1;strokeColor=#ef4444;strokeWidth=2.5;fontSize=11;fontColor=#ef4444;endArrow=block;endFill=1;" edge="1" parent="1" source="card_untrusted_req" target="card_security_gate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_stage2_to_stage3" value="KMS Sign" style="edgeStyle=none;rounded=0;html=1;strokeColor=#22c55e;strokeWidth=2.5;fontSize=11;fontColor=#16a34a;endArrow=block;endFill=1;" edge="1" parent="1" source="card_security_gate" target="card_signed_jwt"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Bottom Explanatory Banner -->
        <mxCell id="card_wire_footer" value="&lt;b style=&quot;font-size:11px;color:#1e3a8a;&quot;&gt;WIRE-LEVEL SECURITY INVARIANT:&lt;/b&gt; &lt;span style=&quot;font-size:10.5px;color:#334155;&quot;&gt;Hop 1 PEP acts as the strict trust boundary. Downstream Hops 2–5 completely ignore caller-provided HTTP headers and strictly bind execution to the immutable Cloud KMS-signed STS JWT context verified against in-memory cached JWKS with zero per-hop RPC latency.&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#bfdbfe;strokeWidth=1.2;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="1120" height="55" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>