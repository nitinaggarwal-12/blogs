        <mxCell id="plane_guide_hdr" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:700;color:#0F172A;letter-spacing:0.3px;&quot;&gt;WHO RUNS WHAT IN PATTERN A (POOL • 1.0x BASELINE COGS)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="34" y="554" width="490" height="18" as="geometry"/></mxCell>
        <mxCell id="legend_plane_guide_row_CONTROL" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10px;line-height:1.25;color:#0F172A;text-align:left;&quot;&gt;&lt;b style=&quot;color:#174EA6;&quot;&gt;CONTROL PLANE&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Identity, ingress, 2 gateways, registry, rate limits &amp;amp; audit&lt;/b&gt;&lt;div style=&quot;font-size:9.5px;font-weight:400;color:#475569;margin-top:2px;&quot;&gt;ISV-operated: one shared stack for every tenant. Both gateways, ARD PDP, and Valkey rate limiter sit on the shared path.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F0FE;strokeColor=#8AB4F8;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;" vertex="1" parent="1"><mxGeometry x="34" y="576" width="490" height="77" as="geometry"/></mxCell>
        <mxCell id="legend_plane_guide_row_COMPUTE" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10px;line-height:1.25;color:#0F172A;text-align:left;&quot;&gt;&lt;b style=&quot;color:#137333;&quot;&gt;COMPUTE PLANE&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Front end, pooled ADK runtime (Cloud Run / GKE WarmPool), MCP &amp;amp; models&lt;/b&gt;&lt;div style=&quot;font-size:9.5px;font-weight:400;color:#475569;margin-top:2px;&quot;&gt;Mode A wipes worker RAM after 1 turn (CoW); Mode B latches GKE WarmPool pods (403); models consumed via 32k prefix cache.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E6F4EA;strokeColor=#81C995;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;" vertex="1" parent="1"><mxGeometry x="34" y="659" width="490" height="77" as="geometry"/></mxCell>
        <mxCell id="legend_plane_guide_row_DATA" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10px;line-height:1.25;color:#0F172A;text-align:left;&quot;&gt;&lt;b style=&quot;color:#B06000;&quot;&gt;DATA PLANE&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Sessions (Valkey) + Memory Bank &amp;amp; Data (AlloyDB FORCE RLS)&lt;/b&gt;&lt;div style=&quot;font-size:9.5px;font-weight:400;color:#475569;margin-top:2px;&quot;&gt;Two shared stores: Valkey {tenant}:{user} keys (&amp;lt;5s UNLINK) and AlloyDB kernel FORCE ROW LEVEL SECURITY (0 foreign rows).&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FEF7E0;strokeColor=#FCD34D;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;" vertex="1" parent="1"><mxGeometry x="34" y="742" width="490" height="77" as="geometry"/></mxCell>
        <mxCell id="plane_guide_note" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:9px;color:#64748B;line-height:1.2;&quot;&gt;Tenant users and IdPs (left) are not a plane. Enterprise APIs (right) lead to systems outside the platform; the ISV does not run them.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="34" y="822" width="490" height="22" as="geometry"/></mxCell>
