        <mxCell id="plane_key_COMPUTE" value="&lt;b&gt;COMPUTE  &lt;/b&gt;&lt;font color=&quot;#1F2937&quot;&gt;Not drawn. The rings and the gate act on the agent&amp;#x27;s session before any MCP or cross-cloud egress.&lt;/font&gt;" style="html=1;shadow=0;rounded=1;absoluteArcSize=1;arcSize=5;fillColor=#ECFDF5;strokeColor=#6EE7B7;strokeWidth=1.1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.3;fontColor=#047857;spacing=0;spacingLeft=6;spacingRight=6;spacingTop=1;spacingBottom=1;" vertex="1" parent="plane_layer">
