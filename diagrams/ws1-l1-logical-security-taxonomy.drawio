        <!-- Header -->
        <mxCell id="hdr_title" value="&lt;div style=&quot;font-family:'Google Sans',Roboto,Arial,sans-serif;&quot;&gt;&lt;b style=&quot;font-size:14px;color:#174ea6;&quot;&gt;[WORKSTREAM 1 • C4 LEVEL 1] Multi-Tenant Agentic AI Reference Taxonomy: 3 Logical Security Layers&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;color:#5f6368;&quot;&gt;Enterprise Architectural Boundaries: Ingress PEP, 5-Hop ADK Cryptographic Controller &amp;amp; Multi-Tenant Isolation Enclaves&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
