        <mxCell id="layer_3_lbl" value="&lt;b style=&quot;font-family:'Google Sans',sans-serif;font-size:12px;color:#b06000;&quot;&gt;LOGICAL BOUNDARY 3: MULTI-TENANT ISOLATION ENCLAVES (PATTERNS A, B &amp;amp; C)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;color:#475569;&quot;&gt;Physical Infrastructure Realization • Database Row-Level Security • Dedicated Sovereign Silos • Hybrid Dynamic Tiering&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
