        <mxCell id="plane_guide_hdr" value="WHO RUNS WHAT IN PATTERN C (HUB + PSC SPOKES)" style="html=1;shadow=0;rounded=1;absoluteArcSize=1;arcSize=7;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12.3;fontColor=#0F172A;fontStyle=1;spacing=0;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="plane_layer">
          <mxGeometry x="54.0" y="563.0" width="475.0" height="20.0" as="geometry"/>
        </mxCell>
        <mxCell id="plane_guide_row_CONTROL" value="&lt;b&gt;CONTROL PLANE&lt;/b&gt;&lt;font color=&quot;#0F172A&quot;&gt;&lt;b&gt;  identity, ingress, 2 gateways, registry, graduation&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot;&gt;ISV-operated shared hub. One ingress gateway routes every tenant by tier; the registry holds each tenant&amp;#x27;s approved PSC destination and swaps the pointer on graduation.&lt;/font&gt;" style="html=1;shadow=0;rounded=1;absoluteArcSize=1;arcSize=7;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.6;fontColor=#1D4ED8;spacing=0;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="plane_layer">
          <mxGeometry x="54.0" y="585.5" width="475.0" height="71.2" as="geometry"/>
        </mxCell>
        <mxCell id="plane_guide_row_COMPUTE" value="&lt;b&gt;COMPUTE PLANE&lt;/b&gt;&lt;font color=&quot;#0F172A&quot;&gt;&lt;b&gt;  shared hub ADK runtime + MCP tools in each spoke&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot;&gt;One shared hub runtime serves every tenant, so its capacity follows total turns. MCP tools sit inside each tenant&amp;#x27;s spoke, next to its data.&lt;/font&gt;" style="html=1;shadow=0;rounded=1;absoluteArcSize=1;arcSize=7;fillColor=#ECFDF5;strokeColor=#6EE7B7;strokeWidth=1.1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.6;fontColor=#047857;spacing=0;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="plane_layer">
          <mxGeometry x="54.0" y="661.8" width="475.0" height="71.2" as="geometry"/>
        </mxCell>
        <mxCell id="plane_guide_row_DATA" value="&lt;b&gt;DATA PLANE&lt;/b&gt;&lt;font color=&quot;#0F172A&quot;&gt;&lt;b&gt;  hub sessions (shared) + one Spoke DB per tenant&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot;&gt;Session state is shared in the hub, scoped {tenant}:{user}. Memory, vectors and rows sit in one CMEK spoke DB per tenant behind its own /28 PSC route; a new tenant adds a spoke.&lt;/font&gt;" style="html=1;shadow=0;rounded=1;absoluteArcSize=1;arcSize=7;fillColor=#FFFBEB;strokeColor=#FDBA74;strokeWidth=1.1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.6;fontColor=#B45309;spacing=0;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="plane_layer">
          <mxGeometry x="54.0" y="738.0" width="475.0" height="71.2" as="geometry"/>
        </mxCell>
        <mxCell id="plane_guide_note" value="Tenant users and IdPs (left) are not a plane. Enterprise APIs (right) lead to systems outside the platform." style="html=1;shadow=0;rounded=1;absoluteArcSize=1;arcSize=6;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.2;fontColor=#475569;spacing=0;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="plane_layer">
          <mxGeometry x="54.0" y="815.5" width="475.0" height="18.8" as="geometry"/>
        </mxCell>
      </root>
