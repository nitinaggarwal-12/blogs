        <mxCell id="e_step1_to_step2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3b82f6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="step_1_box" target="step_2_box"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_step2_to_step3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10b981;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="step_2_box" target="step_3_box"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_step3_to_step4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#eab308;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="step_3_box" target="step_4_box"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_step4_to_step5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ec4899;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="step_4_box" target="step_5_box"><mxGeometry relative="1" as="geometry"/></mxCell>
