        <!-- Header -->
        <mxCell id="hdr_title" value="&lt;div style=&quot;font-family:'Google Sans',Roboto,Arial,sans-serif;&quot;&gt;&lt;b style=&quot;font-size:14px;color:#174ea6;&quot;&gt;[WORKSTREAM 1 • C4 LEVEL 3] 5-Actor UML Sequence Swimlane, Fail-Closed Circuit Breakers &amp;amp; Stampede Recovery&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;color:#5f6368;&quot;&gt;Synchronous Request Execution Path • Hop-by-Hop Policy Enforcement • Fail-Closed Error Traps&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="1140" height="40" as="geometry"/>
        </mxCell>

        <!-- 5 Actor Header Blocks -->
