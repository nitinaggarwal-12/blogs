        <mxCell id="hdr_title" value="&lt;b&gt;5-Hop Cryptographic Perimeter Pipeline &amp; Deterministic Contracts&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="542" y="17" width="760" height="40" as="geometry"/></mxCell>
        <mxCell id="r_pill" value="&lt;b&gt;EXT BLUEPRINT #03 • PERIMETER&lt;/b&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.2;fontSize=11;fontColor=#475569;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1315" y="21" width="245" height="32" as="geometry"/></mxCell>
        <mxCell id="sub_lbl" value="End-to-end zero-trust defense across Ingress PEP (Hop 1), ARD PDP &amp; Valkey Bulkheads (Hops 2–3), Model Armor DLP (Hop 4) &amp; AlloyDB RLS / CMEK (Hop 5)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="44" y="76" width="1512" height="28" as="geometry"/></mxCell>
