        <mxCell id="c1_chip" value="&lt;b&gt;CONTROL · Hops 1–2&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#93C5FD;strokeWidth=1;fontSize=10.5;fontColor=#1D4ED8;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="58" y="111" width="215" height="22" as="geometry"/></mxCell>
        <mxCell id="c1_hdr" value="&lt;div style=&quot;text-align:left;padding-left:10px;&quot;&gt;&lt;b style=&quot;font-size:15px;color:#1D4ED8;&quot;&gt;1. Ingress &amp; Edge PEP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#475569;&quot;&gt;Header stripping &amp; STS token exchange&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.2;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56" y="144" width="332" height="62" as="geometry"/></mxCell>
        <mxCell id="c1_k0" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#0F172A;&quot;&gt;Hop 1 Edge PEP Strip&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;External ALB + Cloud Armor WAF strip caller X-Tenant-Id before app code runs.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="56" y="220" width="332" height="122" as="geometry"/></mxCell>
        <mxCell id="c1_k1" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#0F172A;&quot;&gt;IAM STS Token Broker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;RFC 8693 OBO + RFC 9449 DPoP mint 5-min ECDSA P-256 TenantContext JWT.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="56" y="358" width="332" height="122" as="geometry"/></mxCell>
        <mxCell id="c1_k2" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#0F172A;&quot;&gt;In-Memory JWKS + JTI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;&lt;0.15ms ECDSA verify via hot JWKS; 0.4ms Valkey JTI single-use replay guard.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="56" y="496" width="332" height="122" as="geometry"/></mxCell>
        <mxCell id="c1_k3" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#0F172A;&quot;&gt;Fail-Closed HTTP 401&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;Missing, forged, expired, or replayed OIDC/DPoP tokens terminate at edge.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="56" y="634" width="332" height="122" as="geometry"/></mxCell>
