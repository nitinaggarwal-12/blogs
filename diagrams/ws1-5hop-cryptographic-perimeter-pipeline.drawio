        <mxCell id="c2_zone" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#D97706;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="424" y="122" width="356" height="670" as="geometry"/></mxCell>
        <mxCell id="c2_chip" value="&lt;b&gt;CONTROL + COMPUTE · Hops 2–3&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#FCD34D;strokeWidth=1;fontSize=10.5;fontColor=#B06000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="438" y="111" width="215" height="22" as="geometry"/></mxCell>
        <mxCell id="c2_hdr" value="&lt;div style=&quot;text-align:left;padding-left:10px;&quot;&gt;&lt;b style=&quot;font-size:15px;color:#B06000;&quot;&gt;2. ARD PDP &amp; Bulkhead&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#475569;&quot;&gt;Tool catalog pruning &amp; Valkey rate caps&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FCD34D;strokeWidth=1.2;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="436" y="144" width="332" height="62" as="geometry"/></mxCell>
        <mxCell id="c2_k0" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#0F172A;&quot;&gt;ARD Catalog Policy (Hop 2)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;Agent Registry filters MCP tool schemas per tenant; blocks cross-tenant calls.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="436" y="220" width="332" height="122" as="geometry"/></mxCell>
        <mxCell id="c2_k1" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#0F172A;&quot;&gt;gVisor 1-Turn Heap Wipe&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;Cloud Run Gen2 CoW concurrency=1 + gVisor syscall isolation; no /tmp leaks.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="436" y="358" width="332" height="122" as="geometry"/></mxCell>
        <mxCell id="c2_k2" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#0F172A;&quot;&gt;Memorystore Valkey 0.4ms&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;Atomic token-bucket Lua quota: 120 RPM standard / 600 RPM enterprise burst.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="436" y="496" width="332" height="122" as="geometry"/></mxCell>
        <mxCell id="c2_k3" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#0F172A;&quot;&gt;Deterministic 403 &amp; 429&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;Disallowed MCP tools return HTTP 403; noisy-neighbor spikes return HTTP 429.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="436" y="634" width="332" height="122" as="geometry"/></mxCell>
        <mxCell id="arr_1" value="" style="endArrow=block;endFill=1;strokeColor=#D97706;strokeWidth=2.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="460" as="sourcePoint"/><mxPoint x="804" y="460" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c3_zone" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#DC2626;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="804" y="122" width="356" height="670" as="geometry"/></mxCell>
        <mxCell id="c3_chip" value="&lt;b&gt;CONTROL + COMPUTE · Hop 4&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#FCA5A5;strokeWidth=1;fontSize=10.5;fontColor=#B91C1C;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="818" y="111" width="215" height="22" as="geometry"/></mxCell>
        <mxCell id="c3_hdr" value="&lt;div style=&quot;text-align:left;padding-left:10px;&quot;&gt;&lt;b style=&quot;font-size:15px;color:#B91C1C;&quot;&gt;3. Model Armor &amp; 32k Cache&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#475569;&quot;&gt;Dual-path DLP &amp; 89.1% prefix cache reuse&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FCA5A5;strokeWidth=1.2;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="816" y="144" width="332" height="62" as="geometry"/></mxCell>
        <mxCell id="c3_k0" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#0F172A;&quot;&gt;Inline Prompt Screen (&lt;8ms)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;Model Armor scans every user prompt, RAG chunk &amp; MCP response inline.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="816" y="220" width="332" height="122" as="geometry"/></mxCell>
        <mxCell id="c3_k1" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#0F172A;&quot;&gt;Dual-Path PII / PHI DLP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;Detects cross-tenant secrets, PCI PANs, and sensitive entities pre-egress.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="816" y="358" width="332" height="122" as="geometry"/></mxCell>
        <mxCell id="c3_k2" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#0F172A;&quot;&gt;32k Shared Prefix Cache&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;32,768 system tokens cached globally at 0.10x rate -&gt; 89.1% net input savings.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="816" y="496" width="332" height="122" as="geometry"/></mxCell>
        <mxCell id="c3_k3" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#0F172A;&quot;&gt;Jailbreak Halt HTTP 422&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;Indirect prompt injection or unauthorized tool coercion aborts with HTTP 422.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="816" y="634" width="332" height="122" as="geometry"/></mxCell>
