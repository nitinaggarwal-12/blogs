        <mxCell id="c4_zone" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#16A34A;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1184" y="122" width="356" height="670" as="geometry"/></mxCell>
        <mxCell id="c4_chip" value="&lt;b&gt;DATA + CONTROL · Hop 5&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#86EFAC;strokeWidth=1;fontSize=10.5;fontColor=#137333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1198" y="111" width="215" height="22" as="geometry"/></mxCell>
        <mxCell id="c4_hdr" value="&lt;div style=&quot;text-align:left;padding-left:10px;&quot;&gt;&lt;b style=&quot;font-size:15px;color:#137333;&quot;&gt;4. Database RLS &amp; CMEK&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#475569;&quot;&gt;Engine-enforced SQL isolation &amp; crypto kill&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;strokeWidth=1.2;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1196" y="144" width="332" height="62" as="geometry"/></mxCell>
        <mxCell id="c4_k0" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#0F172A;&quot;&gt;AlloyDB FORCE RLS (Pool)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;Middleware sets SET LOCAL app.current_tenant_id; PgBouncer issues DISCARD ALL.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1196" y="220" width="332" height="122" as="geometry"/></mxCell>
        <mxCell id="c4_k1" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#0F172A;&quot;&gt;Pre-Filtered HNSW RAG&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;Inline SQL RLS predicates prune foreign vectors before distance scoring.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1196" y="358" width="332" height="122" as="geometry"/></mxCell>
        <mxCell id="c4_k2" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#0F172A;&quot;&gt;Per-Tenant HSM CMEK&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;Dedicated Cloud KMS FIPS 140-3 Level 3 rings isolate sovereign tenant storage.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1196" y="496" width="332" height="122" as="geometry"/></mxCell>
        <mxCell id="c4_k3" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:12.5px;color:#0F172A;&quot;&gt;Sub-60s HTTP 423 Halt&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155;&quot;&gt;Disabling tenant CMEK triggers &lt;60s (41.2s measured) lock &amp; &lt;5s Valkey purge.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1196" y="634" width="332" height="122" as="geometry"/></mxCell>
        <mxCell id="pk_ctrl" value="&lt;b style=&quot;color:#1D4ED8;&quot;&gt;CONTROL&lt;/b&gt; &lt;span style=&quot;color:#334155;&quot;&gt;Hops 1, 2, 4 + Valkey &amp; CMEK enforce 401/403/429/422/423 fail-closed&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#93C5FD;strokeWidth=1.1;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="44" y="818" width="492" height="32" as="geometry"/></mxCell>
        <mxCell id="pk_comp" value="&lt;b style=&quot;color:#047857;&quot;&gt;COMPUTE&lt;/b&gt; &lt;span style=&quot;color:#334155;&quot;&gt;Cloud Run gVisor 1-turn + 32k Vertex prefix cache (0.10x rate)&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#86EFAC;strokeWidth=1.1;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="554" y="818" width="492" height="32" as="geometry"/></mxCell>
        <mxCell id="pk_data" value="&lt;b style=&quot;color:#C2410C;&quot;&gt;DATA&lt;/b&gt; &lt;span style=&quot;color:#334155;&quot;&gt;AlloyDB FORCE RLS + PgBouncer DISCARD ALL (Pool) &amp; HSM CMEK (Silo)&lt;/span&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FDBA74;strokeWidth=1.1;fontSize=10.5;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1064" y="818" width="492" height="32" as="geometry"/></mxCell>
