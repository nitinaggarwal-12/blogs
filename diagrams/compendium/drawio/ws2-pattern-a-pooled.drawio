        <mxCell id="plane_guide_hdr" value="WHO RUNS WHAT IN PATTERN A (POOL)" style="html=1;shadow=0;rounded=1;absoluteArcSize=1;arcSize=7;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12.3;fontColor=#0F172A;fontStyle=1;spacing=0;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="plane_layer">
          <mxGeometry x="54.0" y="563.0" width="475.0" height="20.0" as="geometry"/>
        </mxCell>
        <mxCell id="plane_guide_row_CONTROL" value="&lt;b&gt;CONTROL PLANE&lt;/b&gt;&lt;font color=&quot;#0F172A&quot;&gt;&lt;b&gt;  identity, ingress, 2 gateways, registry, rate limits, audit&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot;&gt;ISV-operated: one shared stack for every tenant. Both gateways and the rate limiter sit on every request, so their capacity follows request volume.&lt;/font&gt;" style="html=1;shadow=0;rounded=1;absoluteArcSize=1;arcSize=7;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.6;fontColor=#1D4ED8;spacing=0;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="plane_layer">
          <mxGeometry x="54.0" y="585.5" width="475.0" height="71.2" as="geometry"/>
        </mxCell>
        <mxCell id="plane_guide_row_COMPUTE" value="&lt;b&gt;COMPUTE PLANE&lt;/b&gt;&lt;font color=&quot;#0F172A&quot;&gt;&lt;b&gt;  front end, ADK runtime, MCP servers, A2A agents, models&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot;&gt;ISV-operated pool for the runtime, MCP and A2A; models are consumed as a service (Gemini, 3P LLMs). One pool, so capacity follows total turns across tenants.&lt;/font&gt;" style="html=1;shadow=0;rounded=1;absoluteArcSize=1;arcSize=7;fillColor=#ECFDF5;strokeColor=#6EE7B7;strokeWidth=1.1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.6;fontColor=#047857;spacing=0;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="plane_layer">
          <mxGeometry x="54.0" y="661.8" width="475.0" height="71.2" as="geometry"/>
        </mxCell>
        <mxCell id="plane_guide_row_DATA" value="&lt;b&gt;DATA PLANE&lt;/b&gt;&lt;font color=&quot;#0F172A&quot;&gt;&lt;b&gt;  sessions (Valkey) + Memory Bank &amp;amp; Data (AlloyDB FORCE RLS)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#334155&quot;&gt;ISV-operated, two shared stores. A tenant is a {tenant}:{user} key and a row filter (WHERE tenant_id = ...), not a separate database.&lt;/font&gt;" style="html=1;shadow=0;rounded=1;absoluteArcSize=1;arcSize=7;fillColor=#FFFBEB;strokeColor=#FDBA74;strokeWidth=1.1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.6;fontColor=#B45309;spacing=0;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="plane_layer">
          <mxGeometry x="54.0" y="738.0" width="475.0" height="71.2" as="geometry"/>
        </mxCell>
        <mxCell id="plane_guide_note" value="Tenant users and IdPs (left) are not a plane. Enterprise APIs (right) lead to systems outside the platform; the ISV does not run them." style="html=1;shadow=0;rounded=1;absoluteArcSize=1;arcSize=6;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.2;fontColor=#475569;spacing=0;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="plane_layer">
          <mxGeometry x="54.0" y="815.5" width="475.0" height="18.8" as="geometry"/>
        </mxCell>
