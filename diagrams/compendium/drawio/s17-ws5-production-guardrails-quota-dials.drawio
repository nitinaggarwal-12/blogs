        <mxGeometry x="96" y="544" width="656" height="148" as="geometry"/>
      </mxCell>
      <mxCell id="s17_lc3_bar" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#E37400;strokeColor=none;fontColor=#FFFFFF;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
        <mxGeometry x="96" y="544" width="10" height="148" as="geometry"/>
      </mxCell>
      <mxCell id="s17_lc3_txt" value="&lt;div style='font-family:Arial,Helvetica,sans-serif;color:#202124;'&gt;&lt;div style='font-size:13px;font-weight:700;line-height:1.18;'&gt;Guardrail 03 · Singleflight Stampede Lock &amp;amp; Scoped UNLINK (&amp;lt; 5.0 s)&lt;/div&gt;&lt;div style='height:3px;'&gt;&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#5F6368;'&gt;• SET lock:{tenant}:schema NX PX 5000 prevents cold-start thundering herds on schema refresh.&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#5F6368;'&gt;• Scoped SCAN 0 MATCH {tenant}:* -&amp;gt; UNLINK evicts 1 tenant in &amp;lt;5s while keeping siblings at 100%.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#202124;verticalAlign=middle;align=left;spacingLeft=16;shadow=0;" vertex="1" parent="1">
        <mxGeometry x="122" y="554" width="616" height="128" as="geometry"/>
      </mxCell>
