      <mxCell id="s17_q2" value="&lt;div style='font-family:Arial,Helvetica,sans-serif;color:#202124;'&gt;&lt;div style='font-size:13px;font-weight:700;line-height:1.18;'&gt;1,500 IAM Bindings&lt;/div&gt;&lt;div style='height:3px;'&gt;&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#5F6368;'&gt;Hard GCP limit per resource&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#5F6368;'&gt;1 Principal Access Boundary / Silo&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#5F6368;'&gt;Triggers Pattern A → C / B split&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#5F6368;'&gt;Automated via Terraform factory&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#202124;verticalAlign=middle;align=left;spacingLeft=16;shadow=0;" vertex="1" parent="1">
        <mxGeometry x="1190" y="224" width="314" height="218" as="geometry"/>
      </mxCell>
      <mxCell id="s17_q3" value="&lt;div style='font-family:Arial,Helvetica,sans-serif;color:#202124;'&gt;&lt;div style='font-size:13px;font-weight:700;line-height:1.18;'&gt;/28 PSC Subnet (16 IPs)&lt;/div&gt;&lt;div style='height:3px;'&gt;&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#5F6368;'&gt;Dedicated Pattern C spoke NAT&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#5F6368;'&gt;Dynamic port allocation enabled&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#5F6368;'&gt;Auto-expands /28 → /27 at 50%&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#5F6368;'&gt;0 inbound Spoke→Hub paths&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#202124;verticalAlign=middle;align=left;spacingLeft=16;shadow=0;" vertex="1" parent="1">
        <mxGeometry x="848" y="470" width="314" height="222" as="geometry"/>
      </mxCell>
      <mxCell id="s17_q4" value="&lt;div style='font-family:Arial,Helvetica,sans-serif;color:#202124;'&gt;&lt;div style='font-size:13px;font-weight:700;line-height:1.18;'&gt;&amp;lt; 60s CMEK Halt SLA&lt;/div&gt;&lt;div style='height:3px;'&gt;&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#B06000;'&gt;60s kms.encrypt(ping) heartbeat&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#B06000;'&gt;FIPS 140-3 L3 key version revoke&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#B06000;'&gt;Verified chaos drill halt: 41.2s&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#B06000;'&gt;Returns HTTP 403 CMEK_DENIED&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#E37400;strokeWidth=2;fontColor=#202124;verticalAlign=middle;align=left;spacingLeft=16;shadow=0;" vertex="1" parent="1">
        <mxGeometry x="1190" y="470" width="314" height="222" as="geometry"/>
      </mxCell>
      <mxCell id="s17_bot_bar" value="&lt;div style='font-family:Courier New,monospace;color:#FFFFFF;'&gt;&lt;div style='font-size:13px;font-weight:700;line-height:1.18;'&gt;DETERMINISTIC WIRE &amp;amp; KERNEL INVARIANTS ENFORCED IN CI/CD BEFORE EVERY DEPLOYMENT&lt;/div&gt;&lt;div style='height:3px;'&gt;&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#DADCE0;'&gt;SET LOCAL app.current_tenant_id = $jwt_tid   |   PgBouncer DISCARD ALL   |   SCAN 0 MATCH {tenant}:* UNLINK   |   kms.encrypt(ping) &amp;lt;= 60s&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#202124;strokeColor=none;fontColor=#FFFFFF;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
