      <mxCell id="s17_lc1_txt" value="&lt;div style='font-family:Arial,Helvetica,sans-serif;color:#202124;'&gt;&lt;div style='font-size:13px;font-weight:700;line-height:1.18;'&gt;Guardrail 01 · Hop 1 In-Memory JWKS &amp;amp; JTI Denylist (&amp;lt; 0.15 ms)&lt;/div&gt;&lt;div style='height:3px;'&gt;&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#5F6368;'&gt;• 60-minute async background JWKS refresh eliminates synchronous IdP calls on the hot path.&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#5F6368;'&gt;• Valkey JTI denylist check completes in 0.4 ms p99 (7.5% of the 2.0 ms Hop 1 SLA budget).&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#202124;verticalAlign=middle;align=left;spacingLeft=16;shadow=0;" vertex="1" parent="1">
        <mxGeometry x="122" y="234" width="616" height="122" as="geometry"/>
      </mxCell>
      <mxCell id="s17_lc2_box" value="" style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DADCE0;strokeWidth=1;fontColor=#202124;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
        <mxGeometry x="96" y="384" width="656" height="142" as="geometry"/>
      </mxCell>
      <mxCell id="s17_lc2_bar" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#1E8E3E;strokeColor=none;fontColor=#FFFFFF;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
        <mxGeometry x="96" y="384" width="10" height="142" as="geometry"/>
      </mxCell>
      <mxCell id="s17_lc2_txt" value="&lt;div style='font-family:Arial,Helvetica,sans-serif;color:#202124;'&gt;&lt;div style='font-size:13px;font-weight:700;line-height:1.18;'&gt;Guardrail 02 · PgBouncer Transaction Reset &amp;amp; 32k Prefix Order&lt;/div&gt;&lt;div style='height:3px;'&gt;&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#5F6368;'&gt;• Transaction pooler enforces DISCARD ALL on release + SET LOCAL app.current_tenant_id.&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#5F6368;'&gt;• 89.1% net token savings (32,768 / 36,468 tok) with 0 customer bytes in shared cache.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontColor=#202124;verticalAlign=middle;align=left;spacingLeft=16;shadow=0;" vertex="1" parent="1">
        <mxGeometry x="122" y="394" width="616" height="122" as="geometry"/>
      </mxCell>
