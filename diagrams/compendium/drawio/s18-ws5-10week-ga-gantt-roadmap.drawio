      <mxCell id="s18_step1" value="&lt;div style='font-family:Arial,Helvetica,sans-serif;color:#FFFFFF;'&gt;&lt;div style='font-size:13px;font-weight:700;line-height:1.18;'&gt;Step 1 · Weeks 01–02&lt;/div&gt;&lt;div style='font-size:13px;font-weight:700;line-height:1.18;'&gt;5-Hop Edge &amp;amp; IaC&lt;/div&gt;&lt;div style='height:3px;'&gt;&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#E8F0FE;'&gt;• Strip X-Tenant-Id at L7 ALB&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#E8F0FE;'&gt;• OIDC + RFC 9449 DPoP broker&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#E8F0FE;'&gt;• 60m JWKS cache (&amp;lt; 0.15 ms)&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#E8F0FE;'&gt;• SPIFFE mTLS + Zero-PII OTel&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#E8F0FE;'&gt;• Modular Terraform IaC factory&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#E8F0FE;'&gt;Exit Gate: 100% spoof → HTTP 401&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1A73E8;strokeColor=none;fontColor=#FFFFFF;verticalAlign=middle;align=left;spacingLeft=16;shadow=0;" vertex="1" parent="1">
