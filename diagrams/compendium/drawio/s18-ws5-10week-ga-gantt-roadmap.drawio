      <mxCell id="s18_step2" value="&lt;div style='font-family:Arial,Helvetica,sans-serif;color:#FFFFFF;'&gt;&lt;div style='font-size:13px;font-weight:700;line-height:1.18;'&gt;Step 2 · Weeks 03–05&lt;/div&gt;&lt;div style='font-size:13px;font-weight:700;line-height:1.18;'&gt;Pattern A Pool &amp;amp; 32k Cache&lt;/div&gt;&lt;div style='height:3px;'&gt;&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#FCE8E6;'&gt;• Shared Cloud Run + Vertex ADK&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#FCE8E6;'&gt;• &amp;gt;= 32,768 static prefix (0.10x)&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#FCE8E6;'&gt;• ARD filter (-94% tool schemas)&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#FCE8E6;'&gt;• Valkey Lua 120 RPM/user cap&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#FCE8E6;'&gt;• AlloyDB ENABLE &amp;amp; FORCE RLS&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#FCE8E6;'&gt;• PgBouncer DISCARD ALL reset&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#FCE8E6;'&gt;Exit Gate: 950 tenants @ 1.0x COGS&lt;/div&gt;&lt;div style='font-size:11px;font-weight:400;line-height:1.22;color:#FCE8E6;'&gt;Exit Gate: 10/10 SQLi = 0 bleed&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D93025;strokeColor=none;fontColor=#FFFFFF;verticalAlign=middle;align=left;spacingLeft=16;shadow=0;" vertex="1" parent="1">
