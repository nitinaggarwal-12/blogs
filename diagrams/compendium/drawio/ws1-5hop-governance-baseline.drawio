        <mxCell id="legend_plane_guide_row_CONTROL" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10px;line-height:1.25;color:#0F172A;text-align:left;&quot;&gt;&lt;b style=&quot;color:#174EA6;&quot;&gt;CONTROL PLANE&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Hops 1, 2 &amp;amp; 4 + Hop 3 rate cap + Hop 5 perimeters &amp;amp; audit&lt;/b&gt;&lt;div style=&quot;font-size:9.5px;font-weight:400;color:#475569;margin-top:2px;&quot;&gt;80% shared across all tiers: Edge PEP, STS DPoP broker, both Gateways, ARD PDP, Model Armor DLP, Valkey cap &amp;amp; OTel.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F0FE;strokeColor=#8AB4F8;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;" vertex="1" parent="1"><mxGeometry x="34" y="576" width="490" height="77" as="geometry"/></mxCell>
        <mxCell id="legend_plane_guide_row_COMPUTE" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10px;line-height:1.25;color:#0F172A;text-align:left;&quot;&gt;&lt;b style=&quot;color:#137333;&quot;&gt;COMPUTE PLANE&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Front end, Hop 3 ADK runtime (Cloud Run Gen2 gVisor) &amp;amp; 32k prefix&lt;/b&gt;&lt;div style=&quot;font-size:9.5px;font-weight:400;color:#475569;margin-top:2px;&quot;&gt;Runs identical core ADK Python code across every tier; pooled in Patterns A/C or dedicated per project in Pattern B.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E6F4EA;strokeColor=#81C995;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;" vertex="1" parent="1"><mxGeometry x="34" y="659" width="490" height="77" as="geometry"/></mxCell>
        <mxCell id="legend_plane_guide_row_DATA" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10px;line-height:1.25;color:#0F172A;text-align:left;&quot;&gt;&lt;b style=&quot;color:#B06000;&quot;&gt;DATA PLANE&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Hop 3 Valkey sessions + Hop 5 20% per-pattern tenant stores&lt;/b&gt;&lt;div style=&quot;font-size:9.5px;font-weight:400;color:#475569;margin-top:2px;&quot;&gt;Only the 20% Hop 5 perimeter changes by tier: FORCE ROW LEVEL SECURITY pool (A), /28 PSC spoke (C), or HSM CMEK silo (B).&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FEF7E0;strokeColor=#FCD34D;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;" vertex="1" parent="1"><mxGeometry x="34" y="742" width="490" height="77" as="geometry"/></mxCell>
