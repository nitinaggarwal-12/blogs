      <mxCell id="s20_tag4" value="&lt;div style='font-family:Arial,Helvetica,sans-serif;color:#1967D2;'&gt;&lt;div style='font-size:11px;font-weight:700;line-height:1.18;'&gt;VP ENG SIGN-OFF&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EBF2FE;strokeColor=none;fontColor=#1967D2;verticalAlign=middle;align=center;shadow=0;" vertex="1" parent="1">
