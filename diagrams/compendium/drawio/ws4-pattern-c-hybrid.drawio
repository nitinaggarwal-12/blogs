        <mxCell id="plane_guide_hdr" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10.5px;font-weight:700;color:#0F172A;letter-spacing:0.3px;&quot;&gt;WHO RUNS WHAT IN PATTERN C (HUB + /28 PSC • 1.8–2.8x COGS)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="34" y="554" width="490" height="18" as="geometry"/></mxCell>
        <mxCell id="legend_plane_guide_row_CONTROL" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10px;line-height:1.25;color:#0F172A;text-align:left;&quot;&gt;&lt;b style=&quot;color:#174EA6;&quot;&gt;CONTROL PLANE&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Shared hub identity, ingress, 2 gateways, ARD &amp;amp; CAS graduation&lt;/b&gt;&lt;div style=&quot;font-size:9.5px;font-weight:400;color:#475569;margin-top:2px;&quot;&gt;950 Standard / 50 Enterprise split: one hub routes every tenant by STS tier claim with 0 cross-spoke dialing (HTTP 403).&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F0FE;strokeColor=#8AB4F8;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;" vertex="1" parent="1"><mxGeometry x="34" y="576" width="490" height="77" as="geometry"/></mxCell>
        <mxCell id="legend_plane_guide_row_COMPUTE" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;font-size:10px;line-height:1.25;color:#0F172A;text-align:left;&quot;&gt;&lt;b style=&quot;color:#137333;&quot;&gt;COMPUTE PLANE&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;Shared hub Cloud Run Gen2 gVisor runtime + per-spoke MCP tools&lt;/b&gt;&lt;div style=&quot;font-size:9.5px;font-weight:400;color:#475569;margin-top:2px;&quot;&gt;One shared CoW 1-turn wipe hub runtime serves every tenant while enterprise MCP tools sit behind private /28 PSC spokes.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E6F4EA;strokeColor=#81C995;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=3;spacingBottom=3;" vertex="1" parent="1"><mxGeometry x="34" y="659" width="490" height="77" as="geometry"/></mxCell>
